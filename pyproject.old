[project]
name = "crypto-dashboard"
version = "0.1.0"
description = "Interactive cryptocurrency dashboard using Streamlit and CoinGecko API"
readme = "README.md"
requires-python = ">=3.10"
authors = [
    {name = "Christopher P.", email = "cponds1844@floridpoly.edu"}
]

dependencies =[
"streamlit >=1.30.0",
pandas = ">=2.0.0"
requests = ">=2.31.0"
]

[build-system]
requires = ["setuptools>=61.0"]
build-backend = "setuptools.build_meta"